# Sanad — environment template.
#
# Copy to .env and fill in your own key:   cp .env.example .env
# .env is git-ignored and must never be committed.

# --- required ----------------------------------------------------------------
# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# GEMINI_API_KEY and API_KEY are also accepted, in that order of preference.
GOOGLE_API_KEY=replace_with_your_gemini_api_key

# --- optional: models --------------------------------------------------------
# SANAD_CHAT_MODEL=gemini-3.6-flash
# SANAD_EMBEDDING_MODEL=gemini-embedding-2
# SANAD_EMBEDDING_DIMENSIONS=1536
# SANAD_TEMPERATURE=0.1

# --- optional: ingestion and retrieval ---------------------------------------
# Chunk geometry in characters. Smaller chunks give clause-level citations.
# SANAD_CHUNK_TARGET_CHARS=1200
# SANAD_CHUNK_MAX_CHARS=1800
# SANAD_CHUNK_OVERLAP_CHARS=180

# Passages sent to the model per answer, and the pool they are selected from.
# SANAD_TOP_K=6
# SANAD_CANDIDATE_POOL=24
# Relevance/diversity balance: 1.0 = pure relevance, 0.0 = pure diversity.
# SANAD_MMR_LAMBDA=0.72

# --- optional: interface -----------------------------------------------------
# SANAD_DEFAULT_LANGUAGE=en
# SANAD_MAX_UPLOAD_MB=50
